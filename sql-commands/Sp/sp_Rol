 
CREATE PROCEDURE I_Rol
    @ID INT OUTPUT
   ,@NOMBRE VARCHAR(50)
   ,@DESCRIPCION VARCHAR(255)
   ,@NIVELACCESO INT
AS
BEGIN
  BEGIN TRY
    INSERT INTO Rol
    (NOMBRE ,DESCRIPCION ,NIVELACCESO)
    VALUES
    (@NOMBRE ,@DESCRIPCION ,@NIVELACCESO)
     SET @ID = @@IDENTITY
  END TRY
  BEGIN CATCH
     EXECUTE GetErrorInfo
  END CATCH
END;
GO
 
CREATE PROCEDURE U_Rol
    @ID INT = NULL
   ,@NOMBRE VARCHAR(50) = NULL
   ,@DESCRIPCION VARCHAR(255) = NULL
   ,@NIVELACCESO INT = NULL
AS
BEGIN
  BEGIN TRY
    UPDATE Rol SET
    NOMBRE = ISNULL(@NOMBRE, NOMBRE)
   ,DESCRIPCION = ISNULL(@DESCRIPCION, DESCRIPCION)
   ,NIVELACCESO = ISNULL(@NIVELACCESO, NIVELACCESO)
    WHERE ID = ID
  END TRY
  BEGIN CATCH
     EXECUTE GetErrorInfo
  END CATCH
END;
GO
 
 
CREATE PROCEDURE D_Rol
@ID INTEGER
AS
BEGIN
  BEGIN TRY
    DELETE FROM Rol WHERE ID = @ID
  END TRY
  BEGIN CATCH
     EXECUTE GetErrorInfo
  END CATCH
END;
GO
 
CREATE PROCEDURE I_Permiso
    @ID INT OUTPUT
   ,@CODIGO VARCHAR(50)
   ,@NOMBRE VARCHAR(100)
   ,@DESCRIPCION VARCHAR(255)
   ,@MODULO VARCHAR(50)
AS
BEGIN
  BEGIN TRY
    INSERT INTO Permiso
    (CODIGO ,NOMBRE ,DESCRIPCION ,MODULO)
    VALUES
    (@CODIGO ,@NOMBRE ,@DESCRIPCION ,@MODULO)
     SET @ID = @@IDENTITY
  END TRY
  BEGIN CATCH
     EXECUTE GetErrorInfo
  END CATCH
END;
GO